# =====================================================================
# VPX — Whitelabel Proxy Reseller — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# =====================================================================

# ---- General ----
APP_ENV=production                # development | production
# Your whitelabel brand name — shown to customers everywhere (also JWT issuer).
APP_NAME=Proxia
PUBLIC_BASE_URL=https://panel.example.com   # public URL of the frontend
API_BASE_URL=https://api.example.com        # public URL of the backend
HTTP_PORT=8080
LOG_LEVEL=info                    # debug | info | warn | error

# Trust X-Forwarded-For / X-Real-IP for the client IP used by rate limiting.
# Set to true ONLY when every request necessarily arrives through a reverse
# proxy that overwrites those headers (e.g. the Caddy edge in deploy/Caddyfile,
# or Cloudflare). If the API port is reachable directly, leave this false —
# otherwise anyone can spoof the header and bypass the per-IP login and
# registration rate limits.
TRUST_PROXY=true

# ---- Postgres ----
POSTGRES_USER=vpx
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vpx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable          # use "require"/"verify-full" with managed PG
# Full DSN is derived from the above; override only if needed:
# DATABASE_URL=postgres://vpx:pass@postgres:5432/vpx?sslmode=disable

# ---- Redis ----
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth / JWT ----
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-64-char-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h              # 30 days
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true                # true in production (HTTPS only)

# ---- Google OAuth ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://api.example.com/api/v1/auth/google/callback

# ---- Cloudflare Turnstile (Managed) ----
TURNSTILE_SITE_KEY=               # public, exposed to frontend
TURNSTILE_SECRET_KEY=             # server-side secret
TURNSTILE_ENABLED=true

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx   # exposed to frontend

# ---- NOWPayments (crypto) ----
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io

# ---- VaultProxies reseller API (https://vaultproxies.net/docs) ----
# Auth is a single X-API-Key header. Endpoints: /api/reseller/{balance,
# categories,order,services}. Set MODE=mock to run the whole stack locally
# without contacting the upstream.
VAULTPROXIES_BASE_URL=https://vaultproxies.net
VAULTPROXIES_API_KEY=
VAULTPROXIES_MODE=live            # live | mock

# Proxy gateways ("host:port") per type. The order endpoint returns the
# username/password but NOT the gateway endpoint — copy these from your
# reseller dashboard's connection/generator page.
VAULT_GATEWAY_RESIDENTIAL=
VAULT_GATEWAY_DATACENTER=
VAULT_GATEWAY_IPV6=

# ---- Reseller pricing / margin ----
# Retail = round(wholesale * RESELLER_MARKUP). VaultProxies resells at ~50% of
# retail, so 2.0 reproduces their public retail prices. Tune to your margin.
RESELLER_MARKUP=2.0
# Minimum wallet top-up in USD cents.
MIN_TOPUP_CENTS=500

# ---- Frontend (Next.js public env) — your whitelabel brand ----
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://panel.example.com   # canonical site URL (SEO: sitemap/canonical/OG)
NEXT_PUBLIC_SITE_NAME=Proxia
NEXT_PUBLIC_SITE_TAGLINE=Premium residential, ISP, datacenter & mobile proxies — provisioned in seconds.
NEXT_PUBLIC_SUPPORT_EMAIL=support@proxia.io
NEXT_PUBLIC_IP_COUNT=32M+
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
