# Production reverse proxy with automatic HTTPS (Let's Encrypt).
# Replace the domains below and run: docker compose --profile edge up -d
#
# Both subdomains share the registrable domain so the auth cookies
# (SameSite=Lax, Domain=.example.com) are sent on panel<->api requests.

{
	# ---- Cloudflare (orange cloud) support ----
	#
	# When a hostname is proxied by Cloudflare, every request reaches this edge
	# from a Cloudflare address. Without the block below, all users would share
	# a handful of apparent IPs and therefore a single per-IP rate-limit bucket,
	# so one attacker could exhaust the login limit for everybody.
	#
	# trusted_proxies makes Caddy accept CF-Connecting-IP *only* from Cloudflare
	# ranges. A request arriving directly at the origin cannot forge it.
	#
	# If you are NOT using Cloudflare's proxy, this block is harmless: no request
	# will match the ranges, so the real peer address is used.
	#
	# Refresh the list periodically from https://www.cloudflare.com/ips/
	servers {
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

panel.example.com {
	encode gzip zstd
	reverse_proxy frontend:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

api.example.com {
	encode gzip zstd
	reverse_proxy backend:8080 {
		# Caddy APPENDS to X-Forwarded-For by default, so a client-supplied value
		# stays first in the list — and that is the entry the backend reads.
		# Overwrite it, or anyone can forge the header and bypass the per-IP auth
		# rate limits.
		#
		# {http.request.client_ip} is the real client: behind Cloudflare it comes
		# from CF-Connecting-IP (accepted only from the trusted ranges above);
		# otherwise it is the direct peer address.
		header_up X-Forwarded-For {http.request.client_ip}
		header_up X-Real-IP {http.request.client_ip}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}
